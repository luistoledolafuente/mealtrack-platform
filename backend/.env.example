# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mealtrack
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# App
API_PREFIX=/api/v1
CORS_ORIGIN=*

# Logging
LOG_LEVEL=debug
