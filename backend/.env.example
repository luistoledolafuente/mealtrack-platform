# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mealtrack

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# API
API_PREFIX=/api/v1
CORS_ORIGIN=*

# Logging
LOG_LEVEL=debug

# Production requires DATABASE_URL, a JWT_SECRET of at least 32 characters
# different from dev-secret, and an explicit CORS_ORIGIN different from *.
